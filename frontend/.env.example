# Frontend dev server port (uncommon default to avoid conflicts).
VITE_PORT=4329

# Backend base URL (used by the dev-server /api proxy).
VITE_BACKEND_URL=http://127.0.0.1:8729

# Optional: API base URL for production builds (vite preview / static hosting).
# Leave empty in dev — the proxy handles it.
VITE_API_BASE_URL=
