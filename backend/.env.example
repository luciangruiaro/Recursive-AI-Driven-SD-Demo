# Required: your OpenAI API key (kept out of config.toml on purpose).
OPENAI_API_KEY=sk-replace-me

# Absolute path to the repo Claude Code should operate on. The backend will
# `cd` here when spawning the `claude` CLI subprocess.
# Default for this checkout — change per machine if you move the repo.
CLAUDE_CODE_TARGET_DIR=C:/Users/lugr/Desktop/lgro/git/Recursive-AI-Driven-SD-Demo

# Absolute path to the directory CONTAINING the config.toml the self-evolving
# module modifies. Today that's this backend/ folder — the system edits its
# own config — but it can point elsewhere if you want /self to target a
# different project.
SELF_EVOLVE_TARGET_DIR=C:/Users/lugr/Desktop/lgro/git/Recursive-AI-Driven-SD-Demo/backend
